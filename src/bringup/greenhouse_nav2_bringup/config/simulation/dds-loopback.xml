<?xml version="1.0" encoding="UTF-8" ?>
<!-- All simulation participants run on one host. Small UDP packets avoid
     the verified WSL large-datagram loss without changing message contents. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>simulation_loopback_udp</transport_id>
      <type>UDPv4</type>
      <maxMessageSize>1024</maxMessageSize>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="simulation_loopback" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports><transport_id>simulation_loopback_udp</transport_id></userTransports>
    </rtps>
  </participant>
</profiles>
