Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 28; 32; 38
    Fixed Frame: map
    Frame Rate: 5
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Metric grid
      Enabled: true
      Plane: XY
      Cell Size: 1
      Plane Cell Count: 20
      Color: 80; 90; 100
    - Class: rviz_default_plugins/PointCloud2
      Name: Registered lidar
      Enabled: true
      Topic:
        Value: /localization/registered_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 2
      Color Transformer: AxisColor
      Position Transformer: XYZ
      Axis: Z
      Style: Flat Squares
      Size (m): 0.04
      Decay Time: 2
      Alpha: 0.45
    - Class: rviz_default_plugins/PointCloud2
      Name: Measured terrain
      Enabled: true
      Topic:
        Value: /perception/terrain_map
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 2
      Color Transformer: Intensity
      Position Transformer: XYZ
      Channel Name: intensity
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 0.3
      Style: Flat Squares
      Size (m): 0.08
      Decay Time: 1
      Alpha: 1
    - Class: rviz_default_plugins/Path
      Name: Recorded first FAR graph path
      Enabled: true
      Topic:
        Value: /simulation/rviz_path_snapshot
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 10
      Color: 40; 200; 255
      Line Style: Billboards
      Line Width: 0.08
      Buffer Length: 10
    - Class: rviz_default_plugins/RobotModel
      Name: Clearpath robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/Axes
      Name: Sensor-localized body
      Enabled: true
      Reference Frame: base_link
      Length: 1
      Radius: 0.04
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Site navigation
      Target Frame: base_link
      Distance: 13
      Pitch: 0.85
      Yaw: 0.85
      Focal Point: {X: 2, Y: 0, Z: 0}
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
Window Geometry:
  Width: 1920
  Height: 1080
  X: 0
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: false
