<?xml version="1.0" encoding="UTF-8" ?>
<!-- Test processes only: avoid host/container shared-memory and interface discovery. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>check_loopback_udp</transport_id>
      <type>UDPv4</type>
      <maxMessageSize>1024</maxMessageSize>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="check_loopback" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports><transport_id>check_loopback_udp</transport_id></userTransports>
    </rtps>
  </participant>
</profiles>
