<launch>
  <arg name="publish_rate_hz" default="20" />
  <arg name="look_ahead_distance" default="1.5" />
  <arg name="goal_reached_tolerance" default="0.3" />
  <arg name="default_speed" default="0.4" />
  <arg name="stop_speed" default="0.0" />
  <arg name="publish_debug_path" default="true" />

  <arg name="state_estimation_topic" default="/state_estimation" />
  <arg name="global_path_topic" default="/waypoints" />
  <arg name="local_waypoint_topic" default="/way_point" />
  <arg name="speed_topic" default="/speed" />
  <arg name="debug_path_topic" default="/adapter/waypoint_window" />

  <node pkg="greenhouse_nav"
        type="global_to_local_adapter.py"
        name="global_to_local_adapter"
        output="screen">
    <param name="publish_rate_hz" value="$(arg publish_rate_hz)" />
    <param name="look_ahead_distance" value="$(arg look_ahead_distance)" />
    <param name="goal_reached_tolerance" value="$(arg goal_reached_tolerance)" />
    <param name="default_speed" value="$(arg default_speed)" />
    <param name="stop_speed" value="$(arg stop_speed)" />
    <param name="publish_debug_path" value="$(arg publish_debug_path)" />

    <param name="state_estimation_topic" value="$(arg state_estimation_topic)" />
    <param name="global_path_topic" value="$(arg global_path_topic)" />
    <param name="local_waypoint_topic" value="$(arg local_waypoint_topic)" />
    <param name="speed_topic" value="$(arg speed_topic)" />
    <param name="debug_path_topic" value="$(arg debug_path_topic)" />
  </node>
</launch>
