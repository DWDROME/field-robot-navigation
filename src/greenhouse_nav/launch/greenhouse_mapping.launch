<launch>
  <!--
    对外建图入口。
    目标：一条命令拉起 Mid360 驱动 + FAST-LIO 建图 + RViz。
    说明：
    1) 地图保存仍由 FAST_LIO/config/mid360.yaml 中的 pcd_save 配置控制
    2) 这里额外补固定安装外参 TF，便于建图阶段同时检查 body/base_link 关系
  -->

  <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch">
    <arg name="rviz_enable" value="false" />
    <arg name="rosbag_enable" value="false" />
  </include>

  <include file="$(find fast_lio)/launch/mapping_mid360.launch">
    <arg name="rviz" value="false" />
  </include>

  <node launch-prefix="nice"
        pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find greenhouse_nav)/rviz/greenhouse_mapping_base_link.rviz" />

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="tf_pub_mapping_body_foot"
        args="-0.10 -0.11 0 0 0 0 body body_foot" />

  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="tf_pub_mapping_robot_foot_init"
        args="-0.10 -0.11 0 0 0 0 camera_init robot_foot_init" />

  <!--
    static_transform_publisher 参数顺序：x y z yaw pitch roll frame child
    当前实机为“向前下倾 27°”，这里发布的是 body -> base_link，
    因此要把传感器 body 补回机器人本体语义，应写 +27°。
  -->
  <node pkg="tf2_ros"
        type="static_transform_publisher"
        name="tf_pub_mapping_body_to_base"
        args="0.00 -0.2 0.0 0.0 0.471239 0.0 body base_link" />
</launch>
