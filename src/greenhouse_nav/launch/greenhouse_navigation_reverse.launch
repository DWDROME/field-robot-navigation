<launch>
  <!--
    对外导航入口：反向模式。
    语义：传感器 / body 朝向与车头正好反过来时，给 base_link 追加 180° yaw。
    这里只修正导航语义；建图入口 greenhouse_mapping.launch 保持不动。
  -->

  <include file="$(find greenhouse_nav)/launch/system_greenhouse_with_route_planner.launch">
    <arg name="use_route_planner" value="true" />
    <arg name="use_livox" value="true" />
    <arg name="use_localization" value="true" />
    <arg name="use_fastlio_mapping" value="true" />
    <arg name="use_global_localization" value="true" />
    <arg name="use_map_publisher" value="true" />
    <arg name="use_adapter" value="false" />
    <arg name="use_base_autonomy" value="true" />
    <arg name="use_terrain_analysis" value="true" />
    <arg name="use_terrain_analysis_ext" value="true" />
    <arg name="use_graph_decoder" value="false" />
    <arg name="use_far_rviz" value="true" />
    <arg name="use_base_serial" value="true" />
    <arg name="localization_rviz" value="false" />
    <arg name="body_to_base_yaw" value="3.141592653589793" />
  </include>
</launch>
