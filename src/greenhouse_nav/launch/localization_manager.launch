<launch>
  <arg name="publish_rate_hz" default="50" />
  <arg name="input_odom_topic" default="/Odometry" />
  <arg name="map_to_odom_topic" default="/map_to_odom" />
  <arg name="output_topic" default="/state_estimation" />
  <arg name="output_frame_id" default="map" />
  <arg name="output_child_frame_id" default="base_link" />
  <arg name="broadcast_tf" default="true" />
  <arg name="body_to_base_x" default="0.0" />
  <arg name="body_to_base_y" default="-0.2" />
  <arg name="body_to_base_z" default="0.0" />
  <arg name="body_to_base_roll" default="0.0" />
  <arg name="body_to_base_pitch" default="-0.471239" />
  <arg name="body_to_base_yaw" default="0.0" />

  <node pkg="greenhouse_nav"
        type="localization_manager.py"
        name="localization_manager"
        output="screen">
    <param name="publish_rate_hz" value="$(arg publish_rate_hz)" />
    <param name="input_odom_topic" value="$(arg input_odom_topic)" />
    <param name="map_to_odom_topic" value="$(arg map_to_odom_topic)" />
    <param name="output_topic" value="$(arg output_topic)" />
    <param name="output_frame_id" value="$(arg output_frame_id)" />
    <param name="output_child_frame_id" value="$(arg output_child_frame_id)" />
    <param name="broadcast_tf" value="$(arg broadcast_tf)" />
    <param name="body_to_base_x" value="$(arg body_to_base_x)" />
    <param name="body_to_base_y" value="$(arg body_to_base_y)" />
    <param name="body_to_base_z" value="$(arg body_to_base_z)" />
    <param name="body_to_base_roll" value="$(arg body_to_base_roll)" />
    <param name="body_to_base_pitch" value="$(arg body_to_base_pitch)" />
    <param name="body_to_base_yaw" value="$(arg body_to_base_yaw)" />
  </node>
</launch>
