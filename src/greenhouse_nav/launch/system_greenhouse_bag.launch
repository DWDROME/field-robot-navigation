<launch>
  <!--
    录包回放 / 调参 / 回归入口。
    默认不启动 Livox 与底盘串口；是否播放 rosbag 由 play_bag 控制。
  -->

  <arg name="play_bag" default="false" />
  <arg name="bag_path" default="" />
  <arg name="bag_rate" default="1.0" />

  <arg name="use_localization" default="true" />
  <arg name="use_fastlio_mapping" default="true" />
  <arg name="use_global_localization" default="true" />
  <arg name="use_map_publisher" default="true" />
  <arg name="use_adapter" default="true" />
  <arg name="use_base_autonomy" default="true" />
  <arg name="use_terrain_analysis" default="true" />
  <arg name="localization_rviz" default="false" />

  <arg name="global_path_topic" default="/waypoints" />
  <arg name="state_estimation_topic" default="/state_estimation" />
  <arg name="registered_scan_topic" default="/cloud_registered" />
  <arg name="terrain_map_topic" default="/terrain_map" />
  <arg name="way_point_topic" default="/way_point" />
  <arg name="speed_topic" default="/speed" />
  <arg name="navigation_boundary_topic" default="/navigation_boundary" />
  <arg name="path_topic" default="/path" />
  <arg name="cmd_vel_stamped_topic" default="/cmd_vel_stamped" />
  <arg name="cmd_vel_topic" default="/cmd_vel" />

  <group if="$(arg play_bag)">
    <param name="/use_sim_time" value="true" />
    <node pkg="rosbag"
          type="play"
          name="bag_play"
          output="screen"
          args="--clock -r $(arg bag_rate) $(arg bag_path)" />
  </group>

  <include file="$(find greenhouse_nav)/launch/system_greenhouse_base.launch">
    <arg name="use_livox" value="false" />
    <arg name="use_localization" value="$(arg use_localization)" />
    <arg name="use_fastlio_mapping" value="$(arg use_fastlio_mapping)" />
    <arg name="use_global_localization" value="$(arg use_global_localization)" />
    <arg name="use_map_publisher" value="$(arg use_map_publisher)" />
    <arg name="use_adapter" value="$(arg use_adapter)" />
    <arg name="use_base_autonomy" value="$(arg use_base_autonomy)" />
    <arg name="use_terrain_analysis" value="$(arg use_terrain_analysis)" />
    <arg name="use_base_serial" value="false" />
    <arg name="localization_rviz" value="$(arg localization_rviz)" />
    <arg name="global_path_topic" value="$(arg global_path_topic)" />
    <arg name="state_estimation_topic" value="$(arg state_estimation_topic)" />
    <arg name="registered_scan_topic" value="$(arg registered_scan_topic)" />
    <arg name="terrain_map_topic" value="$(arg terrain_map_topic)" />
    <arg name="way_point_topic" value="$(arg way_point_topic)" />
    <arg name="speed_topic" value="$(arg speed_topic)" />
    <arg name="navigation_boundary_topic" value="$(arg navigation_boundary_topic)" />
    <arg name="path_topic" value="$(arg path_topic)" />
    <arg name="cmd_vel_stamped_topic" value="$(arg cmd_vel_stamped_topic)" />
    <arg name="cmd_vel_topic" value="$(arg cmd_vel_topic)" />
  </include>
</launch>
