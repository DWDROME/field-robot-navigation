<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="greenhouse_mount">
  <xacro:arg name="body_to_base_x" default="0.0" />
  <xacro:arg name="body_to_base_y" default="-0.2" />
  <xacro:arg name="body_to_base_z" default="0.0" />
  <xacro:arg name="body_to_base_roll" default="0.0" />
  <xacro:arg name="body_to_base_pitch" default="-0.471239" />
  <xacro:arg name="body_to_base_yaw" default="0.0" />

  <!--
    安装语义说明：
    1) FAST-LIO 当前输出的是 camera_init -> body，其中 body 更接近传感器 / IMU body。
    2) 当前机器人实机安装是“向前下倾”，按 ROS 坐标约定应理解为绕 Y 轴（pitch）旋转。
    3) 这里建模的是 body -> base_link，所以符号取反：
       - 传感器相对车体前方下倾 27°
       - body -> base_link 应写为 -27° = -0.471239 rad
  -->
  <link name="body" />
  <link name="base_link" />

  <joint name="body_to_base_link" type="fixed">
    <parent link="body" />
    <child link="base_link" />
    <origin xyz="$(arg body_to_base_x) $(arg body_to_base_y) $(arg body_to_base_z)"
            rpy="$(arg body_to_base_roll) $(arg body_to_base_pitch) $(arg body_to_base_yaw)" />
  </joint>
</robot>
