<?xml version="1.0"?>
<package format="3">
  <name>cmu_local_planner</name>
  <version>0.1.0</version>
  <description>Vendor-neutral ROS 2 local planner derived from the CMU autonomy stack.</description>

  <maintainer email="maintainers@greenhouse.invalid">Greenhouse Navigation Maintainers</maintainer>
  <license>BSD</license>
  <url type="repository">https://github.com/HongbiaoZ/autonomous_exploration_development_environment</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
