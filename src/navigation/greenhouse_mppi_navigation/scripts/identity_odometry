#!/usr/bin/env python3
import copy
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from nav_msgs.msg import Odometry
rclpy.init()
node=Node('identity_global_odometry')
publisher=node.create_publisher(Odometry,'/localization/global_odometry',10)
def receive(message):
    if message.header.frame_id!='odom' or message.child_frame_id!='base_link': return
    output=copy.deepcopy(message); output.header.frame_id='map'; publisher.publish(output)
node.create_subscription(Odometry,'/localization/odometry',receive,qos_profile_sensor_data)
try: rclpy.spin(node)
except KeyboardInterrupt: pass
finally:
    node.destroy_node()
    if rclpy.ok(): rclpy.shutdown()
