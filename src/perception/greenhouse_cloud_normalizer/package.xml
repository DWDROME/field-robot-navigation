<?xml version="1.0"?>
<package format="3">
  <name>greenhouse_cloud_normalizer</name>
  <version>0.1.0</version>
  <description>Transform raw PointCloud2 data into the canonical localization frame using tf2.</description>

  <maintainer email="maintainers@greenhouse.invalid">Greenhouse Navigation Maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
