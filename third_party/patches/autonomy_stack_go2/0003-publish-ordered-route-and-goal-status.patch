diff --git a/src/route_planner/far_planner/include/far_planner/ordered_route.hpp b/src/route_planner/far_planner/include/far_planner/ordered_route.hpp
new file mode 100644
index 0000000..c6f818e
--- /dev/null
+++ b/src/route_planner/far_planner/include/far_planner/ordered_route.hpp
@@ -0,0 +1,24 @@
+#pragma once
+#include "utility.h"
+#include <nav_msgs/msg/path.hpp>
+#include <cmath>
+
+// Preserve the complete NodePtrStack produced by GraphPlanner::PathToGoal.
+// Invalid, absent or failed paths publish an empty message with the same header.
+inline nav_msgs::msg::Path OrderedRoute(const NodePtrStack& nodes,
+    const std_msgs::msg::Header& header,const std::string& state) {
+  nav_msgs::msg::Path path; path.header=header;
+  if(nodes.size()<2||nodes.size()>10000||(state!="ready"&&state!="reached")) return path;
+  for(const auto& node:nodes)
+    if(!node||!std::isfinite(node->position.x)||!std::isfinite(node->position.y)||
+       !std::isfinite(node->position.z)) return path;
+  for(std::size_t i=0;i<nodes.size();++i) {
+    geometry_msgs::msg::PoseStamped p; p.header=header;
+    p.pose.position.x=nodes[i]->position.x; p.pose.position.y=nodes[i]->position.y; p.pose.position.z=nodes[i]->position.z;
+    const std::size_t a=i+1<nodes.size()?i:i-1,b=i+1<nodes.size()?i+1:i;
+    const double yaw=std::atan2(nodes[b]->position.y-nodes[a]->position.y,nodes[b]->position.x-nodes[a]->position.x);
+    p.pose.orientation.z=std::sin(yaw/2); p.pose.orientation.w=std::cos(yaw/2);
+    path.poses.push_back(p);
+  }
+  return path;
+}
diff --git a/src/route_planner/far_planner/test/ordered_route_contract.cpp b/src/route_planner/far_planner/test/ordered_route_contract.cpp
new file mode 100644
index 0000000..71798c6
--- /dev/null
+++ b/src/route_planner/far_planner/test/ordered_route_contract.cpp
@@ -0,0 +1,22 @@
+#include "far_planner/ordered_route.hpp"
+#include <cassert>
+#include <iostream>
+int main() {
+  NodePtrStack graph_path;
+  for(const auto& p:std::vector<Point3D>{{0,0,0},{1,2,.1},{4,3,.2},{5,0,.3}}) {
+    auto node=std::make_shared<NavNode>(); node->position=p; graph_path.push_back(node);
+  }
+  std_msgs::msg::Header header; header.frame_id="map"; header.stamp.sec=123; header.stamp.nanosec=456;
+  const auto path=OrderedRoute(graph_path,header,"ready");
+  assert(path.poses.size()==4);
+  for(std::size_t i=0;i<graph_path.size();++i) {
+    const auto& p=path.poses[i];
+    assert(p.header==header && p.pose.position.x==graph_path[i]->position.x && p.pose.position.y==graph_path[i]->position.y);
+    assert(std::fabs(p.pose.orientation.z*p.pose.orientation.z+p.pose.orientation.w*p.pose.orientation.w-1)<1e-9);
+  }
+  assert(OrderedRoute(graph_path,header,"unreachable").poses.empty());
+  assert(OrderedRoute({},header,"ready").poses.empty());
+  graph_path.back()->position.x=NAN; assert(OrderedRoute(graph_path,header,"ready").poses.empty());
+  graph_path.back().reset(); assert(OrderedRoute(graph_path,header,"ready").poses.empty());
+  std::cout<<"FAR ordered NodePtrStack path, headers, orientations and invalidation passed\n";
+}
