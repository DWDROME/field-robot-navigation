From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Greenhouse Jazzy Migration <noreply@example.invalid>
Date: Fri, 31 Jul 2026 00:00:00 +0800
Subject: [PATCH] Limit PCL discovery to localization components

Avoid linking the localization runtime to every installed PCL component,
including the visualization and VTK stack that it does not use.
---
 CMakeLists.txt | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8a8a3fb..7177b4d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -33,8 +33,12 @@ find_package(tf2_ros REQUIRED)
 find_package(tf2_geometry_msgs  REQUIRED)
 find_package(tf2_sensor_msgs  REQUIRED)
 find_package(tf2_eigen REQUIRED)
 find_package(pcl_conversions REQUIRED)
-find_package(PCL REQUIRED)
+find_package(PCL REQUIRED COMPONENTS
+  common
+  filters
+  io
+  registration)
 find_package(Eigen3 REQUIRED)
 find_package(ndt_omp_ros2 REQUIRED)
 find_package(small_gicp QUIET CONFIG)
